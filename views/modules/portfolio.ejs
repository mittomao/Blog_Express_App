<% 
    let name = dataComponent?.name || ""; 
    let avatar = dataComponent?.avatar || ""; 
    let description = dataComponent?.description || ""; 
    let linkcv = dataComponent?.linkcv || ""; 
    if (dataComponent) {
        dataComponent.isDemo = true; 
    } 
%>
<div class="card shadow-sm border-0">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#tab-portfolio-edit" class="nav-link active" data-bs-toggle="tab" aria-selected="true" role="tab">
                    <i class="ti ti-edit me-1"></i> Edit Configuration
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#tab-portfolio-preview" class="nav-link" data-bs-toggle="tab" aria-selected="false" role="tab" tabindex="-1">
                    <i class="ti ti-eye me-1"></i> Live Preview
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#tab-portfolio-code" class="nav-link" data-bs-toggle="tab" aria-selected="false" role="tab" tabindex="-1">
                    <i class="ti ti-code me-1"></i> HTML Source
                </a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <!-- Tab 1: Edit Form -->
            <div class="tab-pane active show" id="tab-portfolio-edit" role="tabpanel">
                <form action="/admin/components/<%= componentName %>" method="post">
                    <div class="mb-3">
                        <label class="form-label required">Full Name</label>
                        <input type="text" class="form-control" name="name" placeholder="Full Name" value="<%= name %>" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Avatar</label>
                        <div class="preview-image <%= !avatar ? 'disable' : '' %> mb-2">
                            <img src="<%= avatar %>" alt="Portfolio avatar preview">
                        </div>
                        <div id="thumbnail-btn" class="btn btn-outline-primary mb-2">
                            <i class="ti ti-photo me-1"></i> Select Avatar...
                        </div>
                        <input type="text" id="thumbnail-input" name="avatar" class="form-control form-control-sm" value="<%= avatar %>" placeholder="Avatar URL" />
                        <small class="form-hint mt-1">Image size under 10MB.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description / Professional Bio</label>
                        <textarea class="form-control" name="description" id="description" rows="3" placeholder="Profile summary..."><%= description %></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Link to CV / Resume</label>
                        <input type="text" class="form-control" name="linkcv" id="linkcv" placeholder="https://..." value="<%= linkcv %>" />
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- Tab 2: Live Preview -->
            <div class="tab-pane" id="tab-portfolio-preview" role="tabpanel">
                <div class="p-3 border rounded bg-surface">
                    <%- include('../components/c_portfolio', { portfolio: dataComponent }) %>
                </div>
            </div>

            <!-- Tab 3: Highlight Code -->
            <div class="tab-pane" id="tab-portfolio-code" role="tabpanel">
                <div class="code-frame">
                    <textarea cols="30" id="source-code" name="" rows="10" class="form-control font-monospace">
<%- include('../components/c_portfolio', { portfolio: dataComponent }) %>
                    </textarea>
                </div>
            </div>
        </div>
    </div>
    <div id="editor-content" style="display: none;" data-key="<%= process.env.FLMNGR_KEY %>"></div>
</div>
