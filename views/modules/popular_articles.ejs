<% 
    let title = dataComponent?.title || ""; 
    let desciption = dataComponent?.desciption || ""; 
    let image = dataComponent?.image || ""; 
    let author = dataComponent?.author || ""; 
    let link = dataComponent?.link || "#"; 
    if (dataComponent) {
        dataComponent.isDemo = true; 
    } 
%>
<div class="card shadow-sm border-0">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#tab-popular-edit" class="nav-link active" data-bs-toggle="tab" aria-selected="true" role="tab">
                    <i class="ti ti-edit me-1"></i> Edit Configuration
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#tab-popular-preview" class="nav-link" data-bs-toggle="tab" aria-selected="false" role="tab" tabindex="-1">
                    <i class="ti ti-eye me-1"></i> Live Preview
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#tab-popular-code" class="nav-link" data-bs-toggle="tab" aria-selected="false" role="tab" tabindex="-1">
                    <i class="ti ti-code me-1"></i> HTML Source
                </a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <!-- Tab 1: Edit Form -->
            <div class="tab-pane active show" id="tab-popular-edit" role="tabpanel">
                <form action="/admin/components/<%= componentName %>" method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label required">Article Title</label>
                        <input type="text" class="form-control" name="title" placeholder="Popular article title" value="<%= title %>" required />
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" class="form-control" name="desciption" placeholder="Short description" value="<%= desciption %>" />
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thumbnail Image</label>
                        <div class="preview-image <%= !image ? 'disable' : '' %> mb-2">
                            <img src="<%= image %>" alt="Popular article preview">
                        </div>
                        <div id="thumbnail-btn" class="btn btn-outline-primary mb-2">
                            <i class="ti ti-photo me-1"></i> Select Image...
                        </div>
                        <input type="text" id="thumbnail-input" name="image" class="form-control form-control-sm" value="<%= image %>" placeholder="Image URL" />
                        <small class="form-hint mt-1">Image size under 10MB.</small>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Author</label>
                        <input type="text" class="form-control" name="author" placeholder="Author name" value="<%= author %>" required />
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Article Link</label>
                        <input type="text" class="form-control" name="link" placeholder="e.g. /post/123456 or external URL" value="<%= link %>" required />
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- Tab 2: Live Preview -->
            <div class="tab-pane" id="tab-popular-preview" role="tabpanel">
                <div class="p-3 border rounded bg-surface">
                    <%- include('../components/c_popular-articles', { popularArticle: dataComponent }) %>
                </div>
            </div>

            <!-- Tab 3: Highlight Code -->
            <div class="tab-pane" id="tab-popular-code" role="tabpanel">
                <div class="code-frame">
                    <textarea cols="30" id="source-code" name="" rows="10" class="form-control font-monospace">
<%- include('../components/c_popular-articles', { popularArticle: dataComponent }) %>
                    </textarea>
                </div>
            </div>
        </div>
    </div>
    <div id="editor-content" style="display: none;" data-key="<%= process.env.FLMNGR_KEY %>"></div>
</div>
