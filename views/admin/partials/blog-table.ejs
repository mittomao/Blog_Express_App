<% if (typeof blogs !== 'undefined' && blogs) { %>
<div class="card shadow-sm border-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2">
            <i class="ti ti-news text-primary"></i>
            <span>All Posts</span>
        </h3>
        <span class="badge bg-primary-lt">
            <%= blogs.length %> displayed / <%= typeof allItems !== 'undefined' ? allItems : blogs.length %> total
        </span>
    </div>

    <div class="table-responsive">
        <table class="table card-table table-vcenter table-hover table-nowrap datatable">
            <thead>
                <tr>
                    <th class="w-1">#</th>
                    <th>Post Title</th>
                    <th>Author</th>
                    <th>Topic</th>
                    <th>Tags</th>
                    <th class="text-center">Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (blogs.length === 0) { %>
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <div class="empty">
                            <div class="empty-icon"><i class="ti ti-inbox fs-1"></i></div>
                            <p class="empty-title">No posts found</p>
                            <p class="empty-subtitle text-muted">Get started by creating a new post.</p>
                            <div class="empty-action">
                                <a href="/admin/add-post" class="btn btn-primary">
                                    <i class="ti ti-plus me-1"></i> Create First Post
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
                <% } %>
                <% blogs.forEach((blog, index) => { %>
                <tr>
                    <td class="text-muted"><%= index + 1 %></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <% if (blog.thumbnail) { %>
                                <span class="avatar avatar-sm rounded" style="background-image: url('<%= blog.thumbnail %>')"></span>
                            <% } else { %>
                                <span class="avatar avatar-sm rounded bg-primary-lt"><i class="ti ti-article"></i></span>
                            <% } %>
                            <div class="text-truncate" style="max-width: 280px;" title="<%= blog.title %>">
                                <a href="/admin/edit-post/<%= blog._id %>" class="text-reset fw-semibold text-decoration-none">
                                    <%= blog.title %>
                                </a>
                                <% if (blog.summary) { %>
                                    <div class="small text-muted text-truncate" style="max-width: 280px;"><%= blog.summary %></div>
                                <% } %>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-secondary-lt"><%= blog.author || 'Admin' %></span>
                    </td>
                    <td>
                        <span class="text-muted"><%= blog.topic || '-' %></span>
                    </td>
                    <td>
                        <% if (blog.tag) { %>
                            <% blog.tag.split(',').forEach(function(t) { if (t.trim()) { %>
                                <span class="badge bg-blue-lt me-1"><%= t.trim() %></span>
                            <% }}) %>
                        <% } else { %>
                            <span class="text-muted small">-</span>
                        <% } %>
                    </td>
                    <td class="text-center">
                        <% if (blog.status) { %>
                            <span class="badge bg-success-lt d-inline-flex align-items-center gap-1">
                                <span class="badge-dot bg-success"></span> Online
                            </span>
                        <% } else { %>
                            <span class="badge bg-secondary-lt d-inline-flex align-items-center gap-1">
                                <span class="badge-dot bg-secondary"></span> Offline
                            </span>
                        <% } %>
                    </td>
                    <td class="text-muted small">
                        <%= new Date(blog.createdAt).toLocaleDateString('vi-VN') %>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a href="/post/<%= blog._id %>" target="_blank" class="btn btn-outline-secondary" title="View Public Post" data-bs-toggle="tooltip">
                                <i class="ti ti-external-link"></i>
                            </a>
                            <a href="/admin/edit-post/<%= blog._id %>" class="btn btn-outline-primary" title="Edit Post" data-bs-toggle="tooltip">
                                <i class="ti ti-pencil"></i>
                            </a>
                            <form action="/admin/delete-post?id=<%= blog._id %>" method="post" class="d-inline"
                                data-confirm-delete="Do you really want to permanently delete post '<%= blog.title ? blog.title.replace(/"/g, '&quot;') : 'Untitled' %>'? This action cannot be undone."
                                data-delete-title="Delete Blog Post">
                                <button type="submit" class="btn btn-outline-danger" title="Delete Post" data-bs-toggle="tooltip">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <p class="m-0 text-muted small">
            Showing <span><%= blogs.length %></span> items out of <span><%= typeof allItems !== 'undefined' ? allItems : blogs.length %></span> total records
        </p>
        <% if (typeof totalPage !== 'undefined' && typeof currentPage !== 'undefined') { %>
            <%- include('../../shared/pagination', { totalPage: totalPage, page: currentPage, isAdmin: true }) %>
        <% } %>
    </div>
</div>
<% } %>
