<%
    let title = dataComponent?.title || "";
    let description = dataComponent?.description || "";
    let bgimage = dataComponent?.bgimage || "";
    if (dataComponent) {
        dataComponent.isDemo = true;
    }
%>
<div class="card shadow-sm border-0">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#tab-newsletter-edit" class="nav-link active" data-bs-toggle="tab" aria-selected="true" role="tab">
                    <i class="ti ti-edit me-1"></i> Edit Configuration
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#tab-newsletter-preview" class="nav-link" data-bs-toggle="tab" aria-selected="false" role="tab" tabindex="-1">
                    <i class="ti ti-eye me-1"></i> Live Preview
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#tab-newsletter-code" class="nav-link" data-bs-toggle="tab" aria-selected="false" role="tab" tabindex="-1">
                    <i class="ti ti-code me-1"></i> HTML Source
                </a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <!-- Tab 1: Edit Form -->
            <div class="tab-pane active show" id="tab-newsletter-edit" role="tabpanel">
                <form action="/admin/components/<%= componentName %>" method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label required">Title</label>
                        <input type="text" class="form-control" name="title" placeholder="Newsletter headline" value="<%= title %>" required />
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" id="description" rows="3" placeholder="Call to action description..."><%= description %></textarea>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Background Image</label>
                        <div class="preview-image <%= !bgimage ? 'disable' : '' %> mb-2">
                            <img src="<%= bgimage %>" alt="Newsletter background preview">
                        </div>
                        <div id="thumbnail-btn" class="btn btn-outline-primary mb-2">
                            <i class="ti ti-photo me-1"></i> Select Background Image...
                        </div>
                        <input type="text" id="thumbnail-input" name="bgimage" class="form-control form-control-sm" value="<%= bgimage %>" placeholder="Image URL" />
                        <small class="form-hint mt-1">Image size under 10MB.</small>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- Tab 2: Live Preview -->
            <div class="tab-pane" id="tab-newsletter-preview" role="tabpanel">
                <div class="p-3 border rounded bg-surface">
                    <%- include('../../client/partials/newsletter', { newsletter: dataComponent }) %>
                </div>
            </div>

            <!-- Tab 3: Highlight Code -->
            <div class="tab-pane" id="tab-newsletter-code" role="tabpanel">
                <div class="code-frame">
                    <textarea cols="30" id="source-code" name="" rows="10" class="form-control font-monospace">
<%- include('../../client/partials/newsletter', { newsletter: dataComponent }) %>
                    </textarea>
                </div>
            </div>
        </div>
    </div>
    <div id="editor-content" style="display: none;" data-key="<%= process.env.FLMNGR_KEY %>"></div>
</div>
