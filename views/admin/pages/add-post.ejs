<%- include('../partials/navbar', { account: typeof account !== 'undefined' ? account : null }) %>

<div class="page-wrapper">
    <%- include('../partials/header', { account: typeof account !== 'undefined' ? account : null, action: null, title: 'Add New Post' }) %>

    <div class="page-body">
        <div class="container-xl">
            <form method="post" role="form" action="/admin/add-post" data-unsaved-guard="true" novalidate>
                <div class="row row-cards">
                    <!-- Left / Main Column: Content Editor -->
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header">
                                <h3 class="card-title fw-bold">Post Content</h3>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label required" for="title">Title</label>
                                    <input type="text" class="form-control" id="title" name="title" placeholder="Enter post title (5-200 characters)..." required />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="summary">Summary</label>
                                    <textarea class="form-control" name="summary" id="summary" rows="3" placeholder="Brief summary of the article (max 500 characters)..."></textarea>
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label required" for="editor-content">Content</label>
                                    <textarea class="form-control" id="editor-content" name="content" rows="12" data-key="<%= process.env.FLMNGR_KEY %>"></textarea>
                                    <div class="invalid-feedback"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Settings, Metadata & Image -->
                    <div class="col-lg-4">
                        <!-- Publishing Settings -->
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header">
                                <h3 class="card-title fw-bold">Publishing Settings</h3>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label" for="status">Status</label>
                                    <select name="status" id="status" class="form-select">
                                        <option value="1" selected>Show (Public)</option>
                                        <option value="0">Hide (Draft)</option>
                                    </select>
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="topic">Topic / Category</label>
                                    <input type="text" class="form-control" id="topic" name="topic" placeholder="e.g. Javascript, Node.js, Life" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="select-tag">Tags</label>
                                    <select class="form-select" name="tag" id="select-tag" multiple placeholder="Choose tags..." data-allow-clear="1">
                                        <% tags.forEach((tag, index)=> { %>
                                            <option value="<%= tag.name %>"><%= tag.name %></option>
                                        <% }) %>
                                    </select>
                                    <div class="invalid-feedback"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Thumbnail Card -->
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-header">
                                <h3 class="card-title fw-bold">Thumbnail Image</h3>
                            </div>
                            <div class="card-body">
                                <div class="preview-image disable mb-2">
                                    <img src="" alt="Thumbnail preview">
                                </div>
                                <div id="thumbnail-btn" class="btn btn-outline-primary w-100 mb-2">
                                    <i class="ti ti-photo me-1"></i> Select from Media Library
                                </div>
                                <input type="text" id="thumbnail-input" name="thumbnail" class="form-control form-control-sm" placeholder="Image URL will appear here" />
                                <div class="invalid-feedback"></div>
                                <small class="form-hint mt-1">Image selected via Flmngr file manager.</small>
                            </div>
                        </div>

                        <!-- Actions Card -->
                        <div class="card shadow-sm border-0">
                            <div class="card-body d-flex gap-2">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="ti ti-device-floppy me-1"></i> Publish Post
                                </button>
                                <a href="/admin" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
