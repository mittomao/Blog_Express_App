<div class="page page-center min-vh-100 d-flex flex-column justify-content-center py-4 bg-body-tertiary">
    <div class="container container-tight">
        <div class="text-center mb-4">
            <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                <img src="<%= process.env.IMAGE_PREFIX %>/logo.png" height="36" alt="Blog Admin" style="object-fit: contain;">
                <span class="fw-bold fs-2 text-heading">CMS Console</span>
            </a>
        </div>

        <div class="card card-md shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h2 text-heading fw-bold m-0">Admin Sign In</h2>
                    <a href="javascript:void(0);" class="btn btn-icon btn-ghost-secondary btn-sm" data-theme-toggle title="Toggle Light/Dark Theme">
                        <i class="ti ti-sun theme-icon-sun fs-2"></i>
                        <i class="ti ti-moon theme-icon-moon fs-2"></i>
                    </a>
                </div>
                <p class="text-muted small mb-4">
                    Enter your administrative credentials to manage posts, tags, widgets and assets.
                </p>

                <form action="/admin/login" method="post" autocomplete="off" novalidate>
                    <div class="mb-3">
                        <label class="form-label required" for="username">Username</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="ti ti-user text-muted"></i></span>
                            <input type="text" class="form-control" id="username" name="username" placeholder="Username" required autofocus />
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="password">Password</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="ti ti-lock text-muted"></i></span>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Password" required />
                            <button type="button" class="btn btn-outline-secondary" id="togglePasswordBtn" title="Toggle password visibility" tabindex="-1">
                                <i class="ti ti-eye" id="togglePasswordIcon"></i>
                            </button>
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>

                    <div class="form-footer mt-4">
                        <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                            <i class="ti ti-login"></i>
                            <span class="fw-semibold">Sign In</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center text-muted mt-3 small">
            &copy; Blog Express App &middot; <a href="/" class="text-muted text-decoration-underline">Return to Public Blog</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var toggleBtn = document.getElementById('togglePasswordBtn');
        var passInput = document.getElementById('password');
        var passIcon = document.getElementById('togglePasswordIcon');
        if (toggleBtn && passInput && passIcon) {
            toggleBtn.addEventListener('click', function () {
                var isPassword = passInput.getAttribute('type') === 'password';
                passInput.setAttribute('type', isPassword ? 'text' : 'password');
                passIcon.className = isPassword ? 'ti ti-eye-off' : 'ti ti-eye';
            });
        }
    });
</script>
