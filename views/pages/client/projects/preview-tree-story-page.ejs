<style>
    body {
        margin: 0;
        padding: 0;
        background: #ffe;
        font-size: 14px;
        font-family: "Playfair", serif;
        color: #231f20;
        overflow: auto;
        height: 100vh;
        max-height: 100vh;
        overflow: hidden;
    }

    a {
        color: #000;
        font-size: 14px;
    }

    #toggle-music {
        border: 1px solid orchid !important;
    }

    #toggle-music svg {
        color: orchid !important;
        fill: orchid !important;
    }

    #main {
        width: 100%;
        height: auto;
    }

    #wrap {
        position: relative;
        margin: 0 auto;
        max-width: 1100px;
        width: 100%;
        height: 70vh;
        margin-top: 10px;
    }

    #clock-box {
        position: absolute;
        left: 0px;
        top: 20px;
        font-size: 20px;
        display: none;
    }

    #clock-box a {
        font-size: 24px;
        text-decoration: none;
    }

    #clock {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    #clock p {
        display: flex;
        flex-direction: column;
        align-items: center;
    }


    #clock .digit {
        font-size: 24px;
        font-family: "Times New Roman", Times, serif;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 8px;
        width: 60px;
        height: 60px;
        border: 1px solid #ccc;
        border-radius: 50%;
        background: white;
        position: relative;

        /* cần để định vị pseudo-element */
    }

    /* Tai trái */
    #clock .digit::before,
    #clock .digit::after {
        content: "";
        position: absolute;
        top: -10px;
        /* cao hơn đầu đồng hồ */
        width: 20px;
        height: 20px;
        border: 1px solid #ccc;
        background: white;
        border-radius: 50%;
        z-index: -1;
    }

    #clock .digit::before {
        left: -5px;
        /* tai trái */
    }

    #clock .digit::after {
        right: -5px;
        /* tai phải */
    }


    #clock .digit b {
        color: rgb(212, 68, 92);
    }

    #canvas {
        margin: 0 auto;
        max-width: 1100px;
        width: 100%;
        height: 70vh;
    }

    @media (max-width: 1920px) {
        #wrap , #canvas {
            height: 600px;
        }
    }

    #error {
        margin: 0 auto;
        text-align: center;
        margin-top: 60px;
        display: none;
    }

    .hand {
        cursor: pointer;
    }

    #code {
        display: none;
        width: 400px;
        height: 350px;
        left: 0px;
        top: 150px;
        position: absolute;
        background-image:
            linear-gradient(0deg, transparent 1.9em, rgba(0, 0, 0, 0.1) 0, transparent 2em),
            linear-gradient(rgba(0, 0, 0, 0.1) 1px, transparent 0);
        background-size: 100% 2em;
        /* Mỗi dòng kẻ cao 2em */
        font-size: 16px;
        /* Cố định font-size để em = px ổn định */
        line-height: 2em;
        /* Quan trọng: khớp với background-size */
        box-sizing: border-box;
        padding-left: 5px;
        /* Thay margin-left của .say bằng padding container */
        overflow-y: scroll;
    }

    #code::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
        background-color: #ffffff;
    }

    #code::-webkit-scrollbar {
        width: 12px;
        background-color: #ffffff;
    }

    #code::-webkit-scrollbar-thumb {
        border-radius: 10px;
        -webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, .3);
        background-color: #555;
    }

    .say {
        display: block;
        line-height: 2em;
        /* Phải khớp với #text */
        margin: 0;
        /* Bỏ margin để không lệch hàng */
        word-break: break-word;
        hyphens: auto;
    }

    .space {
        margin-right: 150px;
    }

    .thumbnails {
        margin: 0 auto;
        max-width: 1100px;
        width: 100%;
        height: 30vh;
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    .thumbnails.slick-initialized {
        display: block;
    }

    .thumbnails img {
        width: 150px;
        height: 200px;
        object-fit: cover;
    }

    /* Tạo khoảng cách phải giữa các slide */
    #thumbnails .slick-slide {
        margin-right: 15px;
        border: 1px solid #ccc;
    }

    /* Tránh bị scroll lệch do tổng margin */
    #thumbnails .slick-track {
        display: flex !important;
    }

    /* (Tùy chọn) Nếu slide cuối bị dư, bạn có thể chỉnh: */
    #thumbnails .slick-slide:last-child {
        margin-right: 0;
    }
</style>

