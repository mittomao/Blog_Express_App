<aside class="navbar navbar-vertical navbar-expand-lg border-end">
    <div class="container-fluid">
        <!-- Mobile Toggle Button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
            aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Brand / Logo -->
        <h1 class="navbar-brand navbar-brand-autodark px-2 py-3 mb-0">
            <a href="/admin" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="<%= process.env.IMAGE_PREFIX %>/logo.png" alt="Blog Admin" class="navbar-brand-image" style="height: 32px; object-fit: contain;">
                <span class="fw-bold fs-3 text-heading">CMS Admin</span>
            </a>
        </h1>

        <!-- Mobile Quick Actions: Theme & User -->
        <div class="navbar-nav flex-row d-lg-none align-items-center gap-2">
            <!-- Mobile Dark/Light Toggle -->
            <div class="nav-item">
                <a href="javascript:void(0);" class="nav-link px-2" data-theme-toggle title="Toggle theme">
                    <i class="ti ti-sun theme-icon-sun fs-2"></i>
                    <i class="ti ti-moon theme-icon-moon fs-2"></i>
                </a>
            </div>
            <% if (typeof account !== 'undefined' && account) { %>
            <div class="nav-item dropdown">
                <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                    <span class="avatar avatar-sm rounded-circle"
                        style="background-image: url('<%= process.env.IMAGE_PREFIX %>/<%= account.avatar %>')"></span>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <div class="dropdown-header">
                        <small class="text-muted">Signed in as</small>
                        <div class="fw-bold"><%= account.username %></div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a href="/" target="_blank" class="dropdown-item">
                        <i class="ti ti-external-link me-2"></i> View Site
                    </a>
                    <a href="/admin/logout" class="dropdown-item text-danger">
                        <i class="ti ti-logout me-2"></i> Logout
                    </a>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Sidebar Navigation Menu (Desktop & Collapsed Mobile) -->
        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                <li class="nav-item">
                    <a class="nav-link" href="/">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-world"></i>
                        </span>
                        <span class="nav-link-title">View Public Site</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/admin">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-file-text"></i>
                        </span>
                        <span class="nav-link-title">Posts</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/admin/tag">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-tags"></i>
                        </span>
                        <span class="nav-link-title">Tags</span>
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#navbar-components" data-bs-toggle="dropdown"
                        data-bs-auto-close="false" role="button" aria-expanded="false">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-puzzle"></i>
                        </span>
                        <span class="nav-link-title">Components</span>
                    </a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="/admin/components/popular_articles">
                            <i class="ti ti-flame me-2 text-muted"></i> Popular Articles
                        </a>
                        <a class="dropdown-item" href="/admin/components/newsletter">
                            <i class="ti ti-mail me-2 text-muted"></i> Newsletter
                        </a>
                        <a class="dropdown-item" href="/admin/components/portfolio">
                            <i class="ti ti-briefcase me-2 text-muted"></i> Portfolio
                        </a>
                        <a class="dropdown-item" href="/admin/components/about_author">
                            <i class="ti ti-user me-2 text-muted"></i> About Author
                        </a>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/admin/media-library">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-photo"></i>
                        </span>
                        <span class="nav-link-title">Media Library</span>
                    </a>
                </li>
            </ul>

            <!-- Theme Mode Toggle on Desktop Sidebar -->
            <div class="my-3 px-3 d-none d-lg-block">
                <button type="button" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2" data-theme-toggle>
                    <i class="ti ti-sun theme-icon-sun fs-2"></i>
                    <i class="ti ti-moon theme-icon-moon fs-2"></i>
                    <span>Toggle Theme</span>
                </button>
            </div>

            <!-- User Footer on Desktop -->
            <div class="mt-auto pt-3 border-top">
                <% if (typeof account !== 'undefined' && account) { %>
                <div class="d-flex align-items-center px-2 py-2">
                    <span class="avatar avatar-sm rounded-circle me-3"
                        style="background-image: url('<%= process.env.IMAGE_PREFIX %>/<%= account.avatar %>')"></span>
                    <div class="flex-fill text-truncate me-2">
                        <div class="fw-semibold text-truncate"><%= account.username %></div>
                        <div class="small text-muted">Administrator</div>
                    </div>
                    <a href="/admin/logout" class="btn btn-icon btn-ghost-danger btn-sm" title="Logout" data-bs-toggle="tooltip">
                        <i class="ti ti-logout fs-2"></i>
                    </a>
                </div>
                <% } else { %>
                <div class="px-2 py-2">
                    <a href="/admin/login" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="ti ti-login"></i>
                        <span>Login</span>
                    </a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</aside>
