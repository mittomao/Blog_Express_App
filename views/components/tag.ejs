<% if (typeof tags !== 'undefined' && tags) { %>
<div class="card shadow-sm border-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2">
            <i class="ti ti-tags text-primary"></i>
            <span>All Tags</span>
        </h3>
        <span class="badge bg-primary-lt">
            <%= tags.length %> tags total
        </span>
    </div>

    <div class="table-responsive">
        <table class="table card-table table-vcenter table-hover table-nowrap datatable">
            <thead>
                <tr>
                    <th class="w-1">#</th>
                    <th>Tag Name</th>
                    <th class="text-center">Associated Posts</th>
                    <th class="text-center">Priority</th>
                    <th>Created At</th>
                    <th>Updated At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (tags.length === 0) { %>
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        <div class="empty">
                            <div class="empty-icon"><i class="ti ti-tags-off fs-1"></i></div>
                            <p class="empty-title">No tags found</p>
                            <p class="empty-subtitle text-muted">Create tags to organize your blog posts.</p>
                            <div class="empty-action">
                                <a href="/admin/add-tag" class="btn btn-primary">
                                    <i class="ti ti-plus me-1"></i> Add First Tag
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
                <% } %>
                <% tags.forEach((tag, index) => { %>
                <tr>
                    <td class="text-muted"><%= index + 1 %></td>
                    <td>
                        <span class="badge bg-blue-lt fs-4 px-2 py-1">
                            <i class="ti ti-tag me-1"></i> <%= tag.name %>
                        </span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-secondary-lt fw-bold">
                            <%= tag.quantity || 0 %>
                        </span>
                    </td>
                    <td class="text-center">
                        <% if (tag.prioritize) { %>
                            <span class="badge bg-primary-lt">
                                <i class="ti ti-star me-1"></i> Primary
                            </span>
                        <% } else { %>
                            <span class="badge bg-secondary-lt text-muted">
                                Secondary
                            </span>
                        <% } %>
                    </td>
                    <td class="text-muted small">
                        <%= new Date(tag.createdAt).toLocaleDateString('vi-VN') %>
                    </td>
                    <td class="text-muted small">
                        <%= new Date(tag.updatedAt).toLocaleDateString('vi-VN') %>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a href="/admin/edit-tag/<%= tag._id %>" class="btn btn-outline-primary" title="Edit Tag" data-bs-toggle="tooltip">
                                <i class="ti ti-pencil"></i>
                            </a>
                            <form action="/admin/delete-tag?id=<%= tag._id %>" method="post" class="d-inline"
                                data-confirm-delete="Do you really want to permanently delete tag '<%= tag.name %>'? This action cannot be undone."
                                data-delete-title="Delete Tag">
                                <button type="submit" class="btn btn-outline-danger" title="Delete Tag" data-bs-toggle="tooltip">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>
